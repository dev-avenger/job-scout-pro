{
  "manifest_version": 3,
  "name": "Auto Job Apply",
  "version": "0.1.0",
  "description": "Capture job listings and save credentials for automated application",
  "permissions": ["activeTab", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  }
}
