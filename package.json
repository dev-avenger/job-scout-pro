{
  "name": "auto-job-apply",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "turbo test:e2e",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "turbo typecheck",
    "db:push": "pnpm --filter @auto-job-apply/db push",
    "db:migrate": "pnpm --filter @auto-job-apply/db migrate",
    "db:seed": "pnpm --filter @auto-job-apply/db seed",
    "db:generate": "pnpm --filter @auto-job-apply/db generate",
    "db:studio": "pnpm --filter @auto-job-apply/db studio",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:build": "docker-compose build",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@auto-job-apply/eslint-config": "workspace:*",
    "@auto-job-apply/tsconfig": "workspace:*",
    "@auto-job-apply/prettier-config": "workspace:*",
    "prettier": "^3.3.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0"
  }
}
