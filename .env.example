# ===========================================
# Auto Job Apply - Environment Configuration
# ===========================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://jobagent:devpassword@localhost:5432/jobagent

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secure-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LLM Providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Google Gemini (free tier available: https://aistudio.google.com/apikey) - used by GeminiProvider
GEMINI_API_KEY=
# Gemini model id (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Ollama (local LLM - free fallback)
OLLAMA_BASE_URL=http://localhost:11434

# --- Job discovery sources ---
# Adzuna job search API (free tier: https://developer.adzuna.com/) - used by AdzunaApiSource
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Two-letter country code for Adzuna queries (default: us)
ADZUNA_COUNTRY=us
# SerpAPI key (https://serpapi.com/) - used by GoogleJobsSource for Google Jobs results
SERPAPI_KEY=
# Note: RemoteOkSource, ArbeitnowSource and RssFeedSource need no key
# (public JSON/RSS endpoints, enabled by default);
# IndeedApiSource scrapes HTML and needs no key but is frequently blocked.

# CAPTCHA Solving
TWOCAPTCHA_API_KEY=

# Email (SMTP for sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email (IMAP for inbox scanning)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=

# --- Resume PDF export ---
# 'chromium' (WYSIWYG, matches the page builder exactly; requires playwright-core
# plus a Chromium binary) or 'pdfkit' (no browser needed, approximate rendering)
PDF_ENGINE=chromium
# Optional explicit Chromium path for the WYSIWYG engine
# PLAYWRIGHT_CHROMIUM_PATH=/usr/bin/chromium
# Alias for PLAYWRIGHT_CHROMIUM_PATH (checked second by html-pdf-generator)
# CHROMIUM_PATH=/usr/bin/chromium

# --- Standalone worker (apps/worker) ---
# Queue processors run INSIDE the API (apps/api QueueModule). The standalone worker
# only contains no-op stubs that would consume and discard real jobs.
# Leave unset/false unless you know what you are doing.
WORKER_STANDALONE=false
