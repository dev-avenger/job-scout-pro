# ===========================================
# Auto Job Apply - Environment Configuration
# ===========================================

# Server
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://jobagent:devpassword@localhost:5432/jobagent

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secure-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# LLM Providers (configure at least one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama (local LLM - free fallback)
OLLAMA_BASE_URL=http://localhost:11434

# CAPTCHA Solving
TWOCAPTCHA_API_KEY=

# Email (SMTP for sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Email (IMAP for inbox scanning)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
